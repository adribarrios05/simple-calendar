# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Publish maintained translations only; local audits now live in private/docs.
/docs/*
!/docs/i18n/
!/docs/screenshots/

/artifacts/