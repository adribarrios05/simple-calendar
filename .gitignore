# Personal editor settings are archived under private/local-config.
# Keep regenerated/restored local settings excluded as well.
/.vscode/
/devtools_options.yaml

# Owner-only planning, verification logs, audits and local configuration.
/private/
# Prevent accidental publication if old local document paths are restored.
/CURRENT.md
/BETA_SCOPE.md
/PRODUCT_ROADMAP_AND_RELEASE_PLAN.md

# Local credentials/databases are not source fixtures.
.env
.env.*
!.env.example
*.pfx
*.p12
*.pem
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.sqlite3-wal
*.sqlite3-shm

